{
  "name": "piconet",
  "version": "4.0.3",
  "description": "Alternative to node streams",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "types": "index.d.ts",
  "scripts": {
    "lint": "standard --fix",
    "test": "node test.js",
    "debug": "node inspect test.js",
    "prepublishOnly": "standard && npm test",
    "types": "(rm *.ts || true) && tsc --skipLibCheck --emitDeclarationOnly --allowJs --checkJs --declaration --removeComments --lib es2022 --target es2022 --moduleResolution nodenext --module nodenext index.js"
  },
