  "bugs": {
    "url": "https://github.com/telamon/piconet/issues"
  },
  "homepage": "https://github.com/telamon/piconet",
  "devDependencies": {
    "hyper-simulator": "^1.3.0",
    "hypercore-protocol": "^8.0.7",
    "hyperswarm": "^4.8.2",
    "standard": "^17.0.0",
    "tape": "^5.6.3",
    "ws": "^8.13.0",
    "wtfnode": "^0.9.3"
  },
  "dependencies": {
    "picofeed": "^8.0.5"
  }
